# Copy to bot/.env and fill in. These match the root .env.example values.
COMETCHAT_APP_ID=your_app_id_here
COMETCHAT_AUTH_KEY=your_auth_key_here
COMETCHAT_REGION=us
COMETCHAT_BOT_UID=mentor_bot

# HTTP port for the bot's /health + /moderate endpoints
BOT_PORT=8787

# LLM provider for the mentor's answers + recaps.
# none | openai | groq | anthropic | gemini | ollama
# Recommended for the demo: groq (fast, free tier). Just set LLM_PROVIDER=groq
# and LLM_API_KEY=gsk_...
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
