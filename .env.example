# ============================================================================
# MentorRoom environment template
# Copy this file to the locations noted below and fill in your values.
#   - web/.env        (Vite reads only VITE_* vars)
#   - bot/.env        (dotenv)
#   - scripts use the same COMETCHAT_* values (root .env is fine)
# ============================================================================

# ---- CometChat credentials (Dashboard -> Your App -> Credentials) ----------
# These three are shared by the web app, the bot and the provision script.
COMETCHAT_APP_ID=your_app_id_here
COMETCHAT_REGION=us
COMETCHAT_AUTH_KEY=your_auth_key_here

# fullAccess REST API key (Dashboard -> API Keys). The Auth Key can create users
# but NOT groups on newer CometChat apps; provision needs this to create rooms.
COMETCHAT_REST_API_KEY=

# REST API base. Leave blank to auto-derive from region:
#   https://api-{region}.cometchat.io/v3
# Override only if your app uses a different host.
COMETCHAT_API_BASE=

# ---- Bot / mentor identity -------------------------------------------------
# The AI mentor is a REAL CometChat user. It logs in with this UID.
COMETCHAT_BOT_UID=mentor_bot
COMETCHAT_BOT_NAME="Mentor AI"

# Demo human users created by the provision script (used to log in in-browser).
COMETCHAT_STUDENT_1=student1
COMETCHAT_STUDENT_2=student2

# ---- LLM (the mentor's brain) ----------------------------------------------
# Provider: openai | groq | anthropic | gemini | ollama | none
# "none" (or no key) => the mentor replies with a built-in fallback answer so
# the demo (typing + real message) still works end to end without any key.
# Groq is fast + has a generous free tier: set LLM_PROVIDER=groq + LLM_API_KEY
# (default model llama-3.1-8b-instant, OpenAI-compatible endpoint auto-set).
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Optional custom base URL (e.g. OpenAI-compatible gateway / local Ollama)
LLM_BASE_URL=

# ---- Moderation ------------------------------------------------------------
# Optional: enable a secondary small-model toxicity call from the web app via
# the bot's /moderate endpoint. The local word-list check always runs.
MODERATION_ENABLE_AI_CHECK=false
