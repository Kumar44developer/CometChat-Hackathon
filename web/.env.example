# Vite exposes only VITE_* variables to the client.
# Copy to web/.env and fill in from your CometChat dashboard.
VITE_COMETCHAT_APP_ID=your_app_id_here
VITE_COMETCHAT_REGION=us
VITE_COMETCHAT_AUTH_KEY=your_auth_key_here

# UID of the AI mentor user (must match the bot + provision script).
VITE_MENTOR_UID=mentor_bot
